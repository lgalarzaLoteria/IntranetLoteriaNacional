<article class="art">
    <div class="form-group row">
        <label for="det" class="col-sm-2 col-form-label">Fecha desde</label>
        <div class="col-sm-2">
            <input type="date" class="form-control rounded" id="fechaDesde" @bind-value="@fechaDesde" pattern="\d{4}/\d{2}/\d{2}" />
        </div>
        <label for="det" class="col-sm-2 col-form-label">Fecha hasta</label>
        <div class="col-sm-2">
            <input type="date" class="form-control rounded" id="fechaHasta" @bind-value="@fechaHasta" pattern="\d{4}/\d{2}/\d{2}" />
        </div>
        <div class="col-sm-2">
            <PhButton Type="IntranetLoteriaNacional.Shared.Buttons.Enums.ButtonType.Primary" OnClick="ConsultarElementosITxFecha" Size="ButtonSize.Medium" Text="Consultar" />
            <PhButton Type="IntranetLoteriaNacional.Shared.Buttons.Enums.ButtonType.Primary" OnClick="Cancelar" Size="ButtonSize.Medium" Text="Cancelar" />
        </div>
    </div>
    <Loading @ref="loader"></Loading>
</article>

