@page "/Maintenance/UbicacionPDS"

@using Blazored.LocalStorage
@using IntranetLoteriaNacional.Shared.ComponentModels
@using IntranetLoteriaNacional.Shared.Modals
@using IntranetLoteriaNacional.Shared.Constants
@using IntranetLoteriaNacional.Validate
@using LoteriaNacionalDominio
@using static LoteriaNacionalDominio.StoreCheckDTO
@using static LoteriaNacionalDominio.SeguridadDTO

@inject ILocalStorageService _session
@inject NavigationManager _navigation
@inject ProjectHttpClient _httpClient
@inject SweetAlertService Swal

<style>
    .column {
        width: 50%;
    }

    /* Clear floats after the columns */
    .row:after {
        content: "";
        display: table;
        clear: both;
    }
</style>

<article class="art">
    <h1 class="tituloPagina">Ubicación de PDS</h1>
    <PhModal @ref="modalUbicacionPDS">
        <Title>Ubicación PDS</Title>
        <Body>
            <EditForm Model="ubicacionPDSDTOForm">
                <div class="form-group row" style="margin-bottom:2%;">
                    <label for="det" class="col-sm-2 col-form-label col-form-label-lg">Nombre PDS</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control form-control-lg" id="det" @bind-value="ubicacionPDSDTOForm.nombrePDS" readonly="readonly">
                    </div>
                </div>
                <div class="form-group row" style="margin-bottom:2%;">
                    <label for="det" class="col-sm-2 col-form-label col-form-label-lg">Latitud</label>
                    <div class="col-sm-10">
                        <input type="number" min="0" max="100" id="det" @bind-value="ubicacionPDSDTOForm.latitudPDS" readonly="readonly" style="width:130px;">
                    </div>
                </div>
                <div class="form-group row" style="margin-bottom:2%;">
                    <label for="det" class="col-sm-2 col-form-label col-form-label-lg">Longitud</label>
                    <div class="col-sm-10">
                        <input type="number" min="0" max="100" id="det" @bind-value="ubicacionPDSDTOForm.longitudPDS" readonly="readonly" style="width:130px;">
                    </div>
                </div>
                <div class="form-group row" style="margin-bottom:2%;">
                    <label for="det" class="col-sm-2 col-form-label col-form-label-lg">Dirección PDS</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control form-control-lg" id="det" @bind-value="ubicacionPDSDTOForm.direccionPDS">
                    </div>
                </div>
            </EditForm>
        </Body>
        <Footer>
            <PhButton Type="IntranetLoteriaNacional.Shared.Buttons.Enums.ButtonType.Success" @onclick="sendData" Size="ButtonSize.Medium" Text="Guardar" isConfirmation="true" />
            <PhButton Type="IntranetLoteriaNacional.Shared.Buttons.Enums.ButtonType.Danger" @onclick="() => modalUbicacionPDS.CloseModal()" Size="ButtonSize.Medium" Text="Cerrar" />
        </Footer>
    </PhModal>
    <div>
        <br />
        <PhTable @ref="_table" TPost="GeolocalizacionDTO" isRefresh="true" TReturn="GeolocalizacionDTO" Body="new GeolocalizacionDTO()" EndPoint="@EndPointStr"
                 SearchDefinition="@(new[]
                 {
                    "nombrePDS"
                 })">
            <PhTableColumnHeaders>
                <PhTableColumn Style="width:30%;" Value="Nombre PDS" IsHeader="true" />
                <PhTableColumn Style="width:15%;" Value="Latitud" IsHeader="true" />
                <PhTableColumn Style="width:15%;" Value="Longitud" IsHeader="true" />
                <PhTableColumn Style="width:40%;" Value="Dirección PDS" IsHeader="true" />
            </PhTableColumnHeaders>
            <PhTableColumnValues>
                <PhTableColumn Value="@context.nombrePDS" Style="width:30%;" />
                <PhTableColumn Value="@context.latitudPDS" Style="width:15%;" />
                <PhTableColumn Value="@context.longitudPDS" Style="width:15%;" />
                <PhTableColumn Value="@context.direccionPDS" Style="width:40%;" />
            </PhTableColumnValues>
            <PhTableActions>
                <PhButton Type="IntranetLoteriaNacional.Shared.Buttons.Enums.ButtonType.Primary" @onclick="@(() => Update(context))" Size="ButtonSize.Small" Text="Editar" />
            </PhTableActions>
        </PhTable>
        <PhNotification @ref="@modalNotification">
        </PhNotification>

    </div>

    <Loading @ref="loader"></Loading>
</article>

@code {
    Loading loader { get; set; } = new();

    private PhTable<GeolocalizacionDTO, GeolocalizacionDTO>? _table = new();
    private PhModal? modalUbicacionPDS { get; set; } = new();
    private PhNotification modalNotification { get; set; } = new();
    GeolocalizacionDTO ubicacionPDSDTOForm = new GeolocalizacionDTO();
    GeolocalizacionDTO ubicacionPDSDTO { get; set; } = null!;
    private string EndPointStr { get; set; } = null!;

    protected override async void OnInitialized()
    {
        EndPointStr = EndPoints.mantenimientoObtieneUbicacionPDS;

        // GeolocalizacionDTO pruebaDTO = new GeolocalizacionDTO();                
        // var respuestaPDSUsuario = await _httpClient.PostAsJsonAsync<RespuestaPDSDTO>(EndPoints.mantenimientoObtieneUbicacionPDS, pruebaDTO);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var item = await _session.GetItemAsync<MenuDTO[]>("_userMenu");
            Validate validate = new Validate();
            if (!validate.isValid("./Maintenance/UbicacionPDS", item))
            {
                _navigation.NavigateTo("./Home/Error");
            }
            await loader.Close();
        }
    }

    // private async Task New()
    // {
    //     ubicacionPDSDTOForm = new GeolocalizacionDTO();
    //     ubicacionPDSDTOForm.secuencial = 0;
    //     await modalSeccion.NewModal();
    // }


    private async Task sendData()
    {
        await loader.Show();
        string mensajeTransaccion = string.Empty;
        string iconoMostrar = string.Empty;

        try
        {
            if (ubicacionPDSDTOForm.direccionPDS == null || ubicacionPDSDTOForm.direccionPDS == string.Empty)
            {
                await loader.Close();
                mensajeTransaccion = "La dirección del PDS debe ser ingresada";
                iconoMostrar = "error";
                await Swal.FireAsync(new SweetAlertOptions
                    {
                        ConfirmButtonColor = "var(--ph-skyblue)",
                        Title = "Intranet Lotería Nacional",
                        Text = mensajeTransaccion,
                        Icon = iconoMostrar
                    });
                return;
            }

            ubicacionPDSDTOForm.usuarioTransaccion = await _session.GetItemAsync<string>("codigoUsuario");
            ubicacionPDSDTOForm.equipoTransaccion = await _session.GetItemAsync<string>("equipoTransaccion");

            var postRequest = new HttpRequestMessage(HttpMethod.Post, EndPoints.mantenimientoActualizarUbicacionPDS)
                {
                    Content = JsonContent.Create(ubicacionPDSDTOForm)
                };
            var postResponse = await _httpClient.SendAsync(postRequest);
            if (postResponse.IsSuccessStatusCode)
            {
                var returnType = await postResponse.Content.ReadFromJsonAsync<RespuestaDTO>()!;
                if (returnType.CodigoError == 0)
                {
                    await _table!.GetDataAsync();
                    mensajeTransaccion = returnType.MensajeError;
                    iconoMostrar = "success";
                }
                else
                {
                    mensajeTransaccion = returnType.MensajeError;
                    iconoMostrar = "error";
                }
                await modalUbicacionPDS.CloseModal();
                await loader.Close();
            }
            else
            {
                //await modalNotification.ErrorModal("Error de servicio");
                mensajeTransaccion = "Error de servicio";
                iconoMostrar = "error";
                await modalUbicacionPDS.CloseModal();
                await loader.Close();
            }

            await Swal.FireAsync(new SweetAlertOptions
                {
                    ConfirmButtonColor = "var(--ph-skyblue)",
                    Title = "Intranet Lotería Nacional",
                    Text = mensajeTransaccion,
                    Icon = iconoMostrar
                });

        }
        catch (HttpRequestException e)
        {
            await modalNotification.ErrorModal(e.Message.ToString());
            await modalUbicacionPDS.CloseModal();
            await loader.Close();
        }
    }

    private async Task Update(GeolocalizacionDTO ubicacionPDSDTO)
    {
        ubicacionPDSDTOForm = ubicacionPDSDTO;
        await modalUbicacionPDS.UpdateModal();
        StateHasChanged();
    }


}
