@page "/Maintenance/ElementosTI"

@using Blazored.LocalStorage
@using IntranetLoteriaNacional.Shared.ComponentModels
@using IntranetLoteriaNacional.Shared.Modals
@using IntranetLoteriaNacional.Shared.Constants
@using IntranetLoteriaNacional.Validate
@using LoteriaNacionalDominio
@using static LoteriaNacionalDominio.MantenimientoDTO
@using static LoteriaNacionalDominio.SeguridadDTO

@inject ILocalStorageService _session
@inject NavigationManager _navigation
@inject ProjectHttpClient _httpClient
@inject SweetAlertService Swal

<style>
    .column {
        width: 50%;
    }

    /* Clear floats after the columns */
    .row:after {
        content: "";
        display: table;
        clear: both;
    }
</style>

<article class="art">
    <h1 class="tituloPagina">Elementos TI</h1>
    <div class="input-group" style="width: 45%;">
        <PhButton Type="IntranetLoteriaNacional.Shared.Buttons.Enums.ButtonType.Primary" OnClick="New" Size="IntranetLoteriaNacional.Shared.Buttons.Enums.ButtonSize.Medium" Text="Agregar" />
    </div>
    <PhModal @ref="modalElementosTI">
        <Title>Sección</Title>
        <Body>
            <EditForm Model="elementosTIDTOForm">
                <div class="form-group row" style="margin-bottom:2%;">
                    <label for="det" class="col-sm-2 col-form-label col-form-label-lg">Elementos TI</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control form-control-lg" id="det" @bind-value="elementosTIDTOForm.nombreElementoIT" placeholder="Ingrese el nombre">
                    </div>
                </div>
                <div class="form-group row" style="margin-bottom:2%;">
                    <div class="col-sm-2">
                        <label for="chek" class="col-sm-2 col-form-label col-form-label-lg">Estado</label>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-check form-switch col-sm-2 col-form-label col-form-label-lg">
                            <input class="form-check-input" @bind-value="@elementosTIDTOForm.estadoElementoIT" checked="@elementosTIDTOForm.estadoElementoIT" type="checkbox" id="flexSwitchCheckChecked">
                            @if (@elementosTIDTOForm.estadoElementoIT == true)
                            {
                                <label class="form-check-label" for="flexSwitchCheckChecked">Activo</label>
                            }
                            else
                            {
                                <label class="form-check-label" for="flexSwitchCheckChecked">Inactivo</label>
                            }
                        </div>
                    </div>
                </div>
            </EditForm>
        </Body>
        <Footer>
            <PhButton Type="IntranetLoteriaNacional.Shared.Buttons.Enums.ButtonType.Success" @onclick="sendData" Size="IntranetLoteriaNacional.Shared.Buttons.Enums.ButtonSize.Medium" Text="Guardar" isConfirmation="true" />
            <PhButton Type="IntranetLoteriaNacional.Shared.Buttons.Enums.ButtonType.Danger" @onclick="() => modalElementosTI.CloseModal()" Size="ButtonSize.Medium" Text="Cerrar" />
        </Footer>
    </PhModal>
    <div>
        <br />
        <PhTable @ref="_table" TPost="ElementosTIDTO" isRefresh="true" TReturn="ElementosTIDTO" Body="new ElementosTIDTO()" EndPoint="@EndPointStr"  
                 SearchDefinition="@(new[]
                 {
                    "nombreElementoIT",
                    "descripcionEstadoElementoTI"
                 })">
            <PhTableColumnHeaders>
                <PhTableColumn Style="width:40%;" Value="Nombre Elemento TI" IsHeader="true" />
                <PhTableColumn Style="width:20%;" Value="Estado Elemento TI" IsHeader="true" />
            </PhTableColumnHeaders>
            <PhTableColumnValues>
                <PhTableColumn Value="@context.nombreElementoIT" Style="width:40%;" />
                @if (context.estadoElementoIT == true)
                {
                    <PhTableColumn StatusColor="var(--ph-green)" Style="width:20%;" Value="@context.descripcionEstadoElementoTI" />
                }
                else
                {
                    <PhTableColumn StatusColor="var(--ph-red)" Style="width:20%;" Value="@context.descripcionEstadoElementoTI" />
                }
            </PhTableColumnValues>
            <PhTableActions>
                <PhButton Type="IntranetLoteriaNacional.Shared.Buttons.Enums.ButtonType.Primary" @onclick="@(() => Update(context))" Size="ButtonSize.Small" Text="Editar" />
            </PhTableActions>

        </PhTable>
        <PhNotification @ref="@modalNotification">
        </PhNotification>

    </div>

    <Loading @ref="loader"></Loading>
</article>


@code {
    Loading loader { get; set; } = new();

    private PhTable<ElementosTIDTO, ElementosTIDTO>? _table = new();
    private PhModal? modalElementosTI { get; set; } = new();
    private PhNotification modalNotification { get; set; } = new();
    ElementosTIDTO elementosTIDTOForm = new ElementosTIDTO();
    ElementosTIDTO elementosTIDTO { get; set; } = null!;
    private string EndPointStr { get; set; } = null!;

    protected override async void OnInitialized()
    {
        EndPointStr = EndPoints.obtenerElementosTI;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var item = await _session.GetItemAsync<MenuDTO[]>("_userMenu");
            Validate validate = new Validate();
            if (!validate.isValid("./Maintenance/ElementosTI", item))
            {
                _navigation.NavigateTo("./Home/Error");
            }
            await loader.Close();
        }
    }

    private async Task New()
    {
        elementosTIDTOForm = new ElementosTIDTO();
        elementosTIDTOForm.estadoElementoIT = true;
        elementosTIDTOForm.codigoElementoIT = 0;
        await modalElementosTI.NewModal();
    }

    private async Task sendData()
    {
        await loader.Show();
        string mensajeTransaccion = string.Empty;
        string iconoMostrar = string.Empty;

        try
        {
            if (elementosTIDTOForm.nombreElementoIT == null || elementosTIDTOForm.nombreElementoIT == string.Empty)
            {
                await loader.Close();
                mensajeTransaccion = "El nombre del elemento de TI debe ser ingresado";
                iconoMostrar = "error";
                await Swal.FireAsync(new SweetAlertOptions
                    {
                        ConfirmButtonColor = "var(--ph-skyblue)",
                        Title = "Intranet Lotería Nacional",
                        Text = mensajeTransaccion,
                        Icon = iconoMostrar
                    });
                return;
            }

            
            elementosTIDTOForm.usuarioTransaccion = await _session.GetItemAsync<string>("codigoUsuario");
            elementosTIDTOForm.equipoTransaccion = await _session.GetItemAsync<string>("equipoTransaccion");

            var postRequest = new HttpRequestMessage(HttpMethod.Post, EndPoints.grabarElementosTI)
                {
                    Content = JsonContent.Create(elementosTIDTOForm)
                };
            var postResponse = await _httpClient.SendAsync(postRequest);
            if (postResponse.IsSuccessStatusCode)
            {
                var returnType = await postResponse.Content.ReadFromJsonAsync<RespuestaDTO>()!;
                if (returnType.CodigoError == 0)
                {
                    await _table!.GetDataAsync();
                    mensajeTransaccion = returnType.MensajeError;
                    iconoMostrar = "success";
                }
                else
                {
                    mensajeTransaccion = returnType.MensajeError;
                    iconoMostrar = "error";
                }
                await modalElementosTI.CloseModal();
                await loader.Close();
            }
            else
            {
                //await modalNotification.ErrorModal("Error de servicio");
                mensajeTransaccion = "Error de servicio";
                iconoMostrar = "error";
                await modalElementosTI.CloseModal();
                await loader.Close();
            }

            await Swal.FireAsync(new SweetAlertOptions
                {
                    ConfirmButtonColor = "var(--ph-skyblue)",
                    Title = "Intranet Lotería Nacional",
                    Text = mensajeTransaccion,
                    Icon = iconoMostrar
                });

        }
        catch (HttpRequestException e)
        {
            await modalNotification.ErrorModal(e.Message.ToString());
            await modalElementosTI.CloseModal();
            await loader.Close();
        }
    }

    private async Task Update(ElementosTIDTO elementoTIDTO)
    {
        elementosTIDTOForm = elementoTIDTO;
        await modalElementosTI.UpdateModal();
        StateHasChanged();
    }

}
